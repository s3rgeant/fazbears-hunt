"VertexlitGeneric"
{
	"$basetexture" "models/realistic_police/taser/taser"
	"$bumpmap" 	   "models/realistic_police/taser/taser_n"

	"$phong" "1"
	"$phongboost" "1"
	"$phongexponent" "15"
	"$phongfresnelranges" "[.2 4 2]"
	
	
	"$envmap" "env_cubemap"
	"$envmapsaturation" ".1"
	"$envmapcontrast" "1"
	"$envmapfresnel" "1"
	"$normalmapalphaenvmapmask" "1"
	"$envmaptint" "[.05 .05 .05]"		

	"$rimlight" "1"
	"$rimlightexponent" "25"
	"$rimlightboost" ".2"	
}
